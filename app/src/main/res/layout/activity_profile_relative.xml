<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_stats_card"
        android:backgroundTint="@color/white"
        android:elevation="2dp"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/black" />

    <ImageView
        android:id="@+id/btnEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_stats_card"
        android:backgroundTint="@color/white"
        android:elevation="2dp"
        android:padding="8dp"
        android:src="@drawable/ic_edit"
        app:tint="@color/teal_primary" />

    <ImageView
        android:id="@+id/profileImage"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_below="@id/btnBack"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/circle_border_green"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/profile_pic" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/profileImage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:text="Johan Smith"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvName"
        android:layout_centerHorizontal="true"
        android:text="California, USA"
        android:textColor="@color/gray_text"
        android:textSize="15sp" />

    <RelativeLayout
        android:id="@+id/statsCard"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_below="@id/tvLocation"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_stats_card"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvBalanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="30dp"
            android:layout_marginTop="22dp"
            android:text="Balance"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvBalanceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvBalanceLabel"
            android:layout_alignStart="@id/tvBalanceLabel"
            android:layout_marginStart="5dp"
            android:layout_marginTop="0dp"
            android:text="00.00"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrdersLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="22dp"
            android:text="Orders"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvOrdersValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOrdersLabel"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:text="10"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="38dp"
            android:text="Total Spent"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTotalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTotalLabel"
            android:layout_alignStart="@id/tvTotalLabel"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:text="000.0"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="30dp"
            android:layout_toStartOf="@id/tvOrdersLabel"
            android:background="#66FFFFFF" />

        <View
            android:layout_width="1dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="30dp"
            android:layout_toEndOf="@id/tvOrdersLabel"
            android:background="#66FFFFFF" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/statsCard"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="15dp">

            <ImageView
                android:id="@+id/iconInfo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/baseline_person_24"
                app:tint="@color/teal_primary" />

            <TextView
                android:id="@+id/textInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/iconInfo"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconInfo"
                android:text="Personal Information"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iconOrder"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_below="@id/textInfo"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/baseline_shopping_cart_24"
                app:tint="@color/teal_primary" />

            <TextView
                android:id="@+id/textOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/iconOrder"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconOrder"
                android:text="Your Order"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iconFav"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_below="@id/textOrder"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/baseline_favorite_24"
                app:tint="@color/teal_primary" />

            <TextView
                android:id="@+id/textFav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/iconFav"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconFav"
                android:text="Your Favourites"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iconPay"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_below="@id/textFav"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/baseline_payment_24"
                app:tint="@color/teal_primary" />

            <TextView
                android:id="@+id/textPay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/iconPay"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconPay"
                android:text="Payment"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iconShop"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_below="@id/textPay"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/outline_store_24"
                app:tint="@color/teal_primary" />

            <TextView
                android:id="@+id/textShop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/iconShop"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconShop"
                android:text="Recommended Shops"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iconLoc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_below="@id/textShop"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/baseline_location_on_24"
                app:tint="@color/teal_primary" />

            <TextView
                android:id="@+id/textLoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/iconLoc"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconLoc"
                android:text="Nearest Shop"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iconLogout"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_below="@id/textLoc"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/outline_logout_24"
                app:tint="@color/teal_primary" />

            <TextView
                android:id="@+id/textLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/iconLogout"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconLogout"
                android:text="Logout"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </RelativeLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#F5F5F5"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="25dp"
            android:src="@drawable/ic_home"
            app:tint="@color/gray_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileAction"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:text="Profile"
            android:textColor="@color/white"
            android:textAllCaps="false"

            android:backgroundTint="@color/teal_primary"

            app:icon="@drawable/baseline_person_24"
            app:iconTint="@color/white"
            app:iconSize="24dp"
            app:iconPadding="8dp"/>
        <ImageView
            android:id="@+id/navCart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerInParent="true"
            android:layout_marginStart="25dp"
            android:src="@drawable/baseline_shopping_cart_24"
            app:tint="@color/gray_text" />

        <ImageView
            android:id="@+id/navBell"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_toStartOf="@id/navCart"
            android:layout_centerVertical="true"
            android:layout_marginEnd="25dp"
            android:src="@drawable/baseline_notifications_24"
            app:tint="@color/gray_text" />

    </RelativeLayout>

</RelativeLayout>